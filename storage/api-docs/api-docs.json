    "paths": {
        "/api/books": {
            "get": {
                "tags": [
                    "Books"
                ],
                "summary": "Get list of books with pagination",
                "description": "Mengambil daftar buku dengan paginasi, total jumlah buku, dan total harga buku",
                "operationId": "03f0d4373f8a3c94cd205dc52ec0f4ae",
                "parameters": [
                    {
                        "name": "page",
                        "in": "query",
                        "description": "Paginasi halaman",
                        "required": true,
                        "schema": {
                            "type": "integer",
                            "example": "1"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Sukses mendapatkan data buku",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "data": {
                                            "type": "array",
                                            "items": {
                                                "properties": {
                                                    "id": {
                                                        "type": "integer",
                                                        "example": 1
                                                    },
                                                    "title": {
                                                        "type": "string",
                                                        "example": "The Great Gatsby"
                                                    },
                                                    "writer": {
                                                        "type": "string",
                                                        "example": "F. Scott Fitzgerald"
                                                    },
                                                    "picture": {
                                                        "type": "string",
                                                        "example": "image_url.jpg"
                                                    }
                                                },
                                                "type": "object"
                                            }
                                        },
                                        "total_books": {
                                            "type": "integer",
                                            "example": 100
                                        },
                                        "total_price": {
                                            "type": "number",
                                            "format": "float",
                                            "example": 500000
                                        },
                                        "pagination": {
                                            "properties": {
                                                "current_page": {
                                                    "type": "integer",
                                                    "example": 1
                                                },
                                                "per_page": {
                                                    "type": "integer",
                                                    "example": 20
                                                },
                                                "total_pages": {
                                                    "type": "integer",
                                                    "example": 5
                                                },
                                                "total_items": {
                                                    "type": "integer",
                                                    "example": 100
                                                }
                                            },
                                            "type": "object"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "500": {
                        "description": "Internal server error",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "message": {
                                            "type": "string",
                                            "example": "Internal server error"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    }
                }
            },
            "post": {
                "tags": [
                    "Books"
                ],
                "summary": "Create a new book",
                "description": "Create a new book with title, writer, and other details",
                "operationId": "storeBook",
                "requestBody": {
                    "description": "Data untuk membuat buku baru",
                    "required": true,
                    "content": {
                        "multipart/form-data": {
                            "schema": {
                                "properties": {
                                    "title": {
                                        "description": "Judul buku",
                                        "type": "string"
                                    },
                                    "writer": {
                                        "description": "Penulis buku",
                                        "type": "string"
                                    },
                                    "publisher_id": {
                                        "description": "ID penerbit",
                                        "type": "integer"
                                    },
                                    "publication_year": {
                                        "description": "Tahun publikasi buku",
                                        "type": "integer"
                                    },
                                    "number_of_pages": {
                                        "description": "Jumlah halaman buku",
                                        "type": "integer"
                                    },
                                    "price": {
                                        "description": "Harga buku",
                                        "type": "integer"
                                    },
                                    "description": {
                                        "description": "Deskripsi buku",
                                        "type": "string"
                                    },
                                    "picture": {
                                        "description": "File gambar buku",
                                        "type": "string",
                                        "format": "binary"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Buku berhasil dibuat",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "message": {
                                            "type": "string",
                                            "example": "Buku berhasil dibuat!"
                                        },
                                        "book": {
                                            "properties": {
                                                "id": {
                                                    "type": "integer",
                                                    "example": 1
                                                },
                                                "title": {
                                                    "type": "string",
                                                    "example": "Contoh Buku"
                                                },
                                                "writer": {
                                                    "type": "string",
                                                    "example": "Nama Penulis"
                                                },
                                                "publisher_id": {
                                                    "type": "integer",
                                                    "example": 123
                                                },
                                                "publication_year": {
                                                    "type": "integer",
                                                    "example": 2020
                                                },
                                                "number_of_pages": {
                                                    "type": "integer",
                                                    "example": 300
                                                },
                                                "price": {
                                                    "type": "integer",
                                                    "example": 50000
                                                },
                                                "description": {
                                                    "type": "string",
                                                    "example": "Ini adalah buku contoh."
                                                },
                                                "picture": {
                                                    "type": "string",
                                                    "example": "image_123.jpg"
                                                }
                                            },
                                            "type": "object"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Request tidak valid",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "message": {
                                            "type": "string",
                                            "example": "Request tidak valid"
                                        },
                                        "error": {
                                            "type": "string",
                                            "example": "Kesalahan dalam data yang dikirim"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    }
                }
            }
        },
