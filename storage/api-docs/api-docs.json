        "/api/books/{id}": {
            "get": {
                "tags": [
                    "Books"
                ],
                "summary": "Get details of a specific book",
                "description": "Retrieve a book by its ID along with its publisher information",
                "operationId": "showBook",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "description": "ID of the book",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Details of the requested book",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "book": {
                                            "properties": {
                                                "id": {
                                                    "type": "integer",
                                                    "example": 1
                                                },
                                                "title": {
                                                    "type": "string",
                                                    "example": "Contoh Buku"
                                                },
                                                "writer": {
                                                    "type": "string",
                                                    "example": "Nama Penulis"
                                                },
                                                "publisher_id": {
                                                    "type": "integer",
                                                    "example": 123
                                                },
                                                "publication_year": {
                                                    "type": "integer",
                                                    "example": 2020
                                                },
                                                "number_of_pages": {
                                                    "type": "integer",
                                                    "example": 300
                                                },
                                                "price": {
                                                    "type": "integer",
                                                    "example": 50000
                                                },
                                                "description": {
                                                    "type": "string",
                                                    "example": "Ini adalah buku contoh."
                                                },
                                                "picture": {
                                                    "type": "string",
                                                    "example": "image_123.jpg"
                                                }
                                            },
                                            "type": "object"
                                        },
                                        "publisher": {
                                            "properties": {
                                                "id": {
                                                    "type": "integer",
                                                    "example": 123
                                                },
                                                "name": {
                                                    "type": "string",
                                                    "example": "Penerbit XYZ"
                                                },
                                                "address": {
                                                    "type": "string",
                                                    "example": "Jl. Penerbit No. 10"
                                                }
                                            },
                                            "type": "object"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "Book not found",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "message": {
                                            "type": "string",
                                            "example": "Buku tidak ditemukan"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    }
                }
