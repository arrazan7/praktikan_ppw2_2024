                    }
                ],
                "requestBody": {
                    "description": "Data to update the book including image upload (optional)",
                    "required": true,
                    "content": {
                        "multipart/form-data": {
                            "schema": {
                                "properties": {
                                    "title": {
                                        "description": "Judul buku",
